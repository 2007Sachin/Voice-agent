# LiveKit Cloud credentials — from https://cloud.livekit.io → your project → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Deepgram — from https://console.deepgram.com → API Keys
# Used for both STT (Nova-2) and TTS (Aura)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Groq — from https://console.groq.com → API Keys
GROQ_API_KEY=your_groq_api_key
