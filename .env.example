# ---------------------------------------------------------------
# Web app (Interview Studio) — server/
# ---------------------------------------------------------------

# Groq — from https://console.groq.com → API Keys.
# Optional: without it the app runs fully offline with built-in
# mock questions and a heuristic report.
GROQ_API_KEY=your_groq_api_key

# Optional overrides
# GROQ_MODEL=llama-3.3-70b-versatile
# PORT=8787
# DATA_DIR=./data/sessions

# ---------------------------------------------------------------
# LiveKit phone/voice agent (optional) — services/voice-agent/
# ---------------------------------------------------------------

# LiveKit Cloud credentials — from https://cloud.livekit.io → your project → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Deepgram — from https://console.deepgram.com → API Keys
# Used for both STT (Nova-2) and TTS (Aura)
DEEPGRAM_API_KEY=your_deepgram_api_key
